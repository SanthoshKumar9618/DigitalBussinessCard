# Copy to backend/.env and fill in. Never commit the real .env.
POSTGRES_DSN=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# "production" stops OTP codes from being written to logs
ENVIRONMENT=development
# Public base URL of this API (used in QR codes / shared links)
APP_DOMAIN=http://localhost:8000
# Comma-separated browser origins allowed by CORS, or *
CORS_ORIGINS=*

# Google sign-in (web client ID from Google Cloud console)
GOOGLE_CLIENT_ID=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
