{
  "expo": {
    "scheme": "smartcard",
    "android": {
      "package": "com.anonymous.smartcardapp",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "yourapp.com",
              "pathPrefix": "/open"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.anonymous.smartcardapp"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "463dffd6-3dac-4995-bb32-2a770048bf66"
      }
    }
  }
}
